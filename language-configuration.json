{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  },
  "wordPattern": "[A-Za-z0-9_][A-Za-z0-9_.-]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*(:|-) ?(\\{[^}\"']*|\\[[^\\]\"']*)?$",
    "decreaseIndentPattern": "^\\s+[}\\]]$"
  }
}
